{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "skipLibCheck": true,
    
    "rootDir": "./src",      
    "outDir": "./dist",     
    "noEmit": false, 

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,         
    "checkJs": false         
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "data"]
}